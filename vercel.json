{
  "services": {
    "frontend": {
      "root": "frontend",
      "outputDirectory": "dist/chefwise/browser",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": ".",
      "entrypoint": "api/index.py",
      "functions": {
        "api/index.py": {
          "maxDuration": 30,
          "includeFiles": "{src,backend,data/processed,models/recetas_modelo}/**",
          "excludeFiles": "{frontend/**,notebooks/**,data/evaluation/**,models/recetas_modelo/recipe_embeddings.npy}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
